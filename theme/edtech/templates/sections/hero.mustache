{{! theme_edtech/sections/hero
    Reference-style full-bleed homepage hero carousel.
    Context: hero.slides from theme_edtech_get_frontpage_slides()
    @template theme_edtech/sections/hero
}}
<section id="edt-home-slider" class="edt-hero edt-hero-slider" aria-label="{{#str}}slider_settings_heading, theme_edtech{{/str}}">
    <div class="edt-slider" data-edt-slider data-interval="6000">
        <div class="edt-slider-viewport">
            {{#hero.slides}}
            <article id="{{id}}"
                     class="edt-slider-slide{{#isactive}} is-active{{/isactive}}"
                     data-edt-slide
                     data-slide-index="{{index}}"
                     data-status-label="{{status_label}}"
                     role="group"
                     aria-roledescription="slide"
                     aria-label="{{status_label}}"
                     {{#isactive}}aria-hidden="false"{{/isactive}}{{^isactive}}aria-hidden="true"{{/isactive}}>
                <div class="edt-container edt-hero-grid">

                    {{! Copy — right side in Arabic/RTL, left side in English/LTR }}
                    <div class="edt-hero-copy">
                        <span class="edt-eyebrow">
                            <span class="dot"></span>
                            {{eyebrow}}
                        </span>

                        <div class="edt-hero-quote" aria-hidden="true">“</div>
                        <h1 class="edt-hero-title">
                            {{title}}
                            <span class="accent">{{title_accent}}</span>
                        </h1>

                        <p class="edt-hero-subtitle">{{subtitle}}</p>

                        <div class="edt-hero-cta">
                            <a href="{{cta1_url}}" class="edt-btn edt-btn-primary">
                                {{cta1_text}}
                                {{#isrtl}}<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>{{/isrtl}}
                                {{^isrtl}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>{{/isrtl}}
                            </a>
                            {{#cta2_text}}
                            <a href="{{cta2_url}}" class="edt-btn edt-btn-hero-secondary">
                                {{cta2_text}}
                            </a>
                            {{/cta2_text}}
                        </div>
                    </div>

                    {{! Visual — uploaded Moodle image or the existing fallback image }}
                    <div class="edt-hero-visual">
                        <div class="edt-hero-media">
                            <div class="edt-hero-media-ring edt-hero-media-ring-outer"></div>
                            <div class="edt-hero-media-ring edt-hero-media-ring-inner"></div>
                            <div class="edt-hero-media-image"{{#image}} style="background-image: url('{{image}}');"{{/image}}>
                                <span class="sr-only">{{card_title}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
            {{/hero.slides}}
        </div>

        <div class="edt-slider-controls">
            <div class="edt-slider-arrows">
                <button type="button" class="edt-slider-arrow edt-slider-prev" data-edt-slider-prev aria-label="{{#str}}slider_previous, theme_edtech{{/str}}">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="edt-slider-arrow edt-slider-next" data-edt-slider-next aria-label="{{#str}}slider_next, theme_edtech{{/str}}">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>

            <div class="edt-slider-dots" data-edt-slider-dots role="tablist" aria-label="{{#str}}slider_settings_heading, theme_edtech{{/str}}">
                {{#hero.slides}}
                <button type="button"
                        class="edt-slider-dot{{#isactive}} is-active{{/isactive}}"
                        data-edt-slider-dot
                        data-slide-index="{{index}}"
                        role="tab"
                        aria-controls="{{id}}"
                        aria-label="{{indicator_label}}"
                        aria-selected="{{#isactive}}true{{/isactive}}{{^isactive}}false{{/isactive}}">
                    <span aria-hidden="true"></span>
                </button>
                {{/hero.slides}}
            </div>
        </div>

        <div class="sr-only" data-edt-slider-status aria-live="polite">
            {{#hero.slides}}{{#isactive}}{{status_label}}{{/isactive}}{{/hero.slides}}
        </div>
    </div>
</section>
